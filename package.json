{
  "name": "react-firebase-chat-app-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "npx firebase-tools emulators:exec --only firestore \"vitest run --config vitest.config.rules.js\"",
    "emulators": "npx firebase-tools emulators:start --only auth,firestore",
    "e2e": "npx firebase-tools emulators:exec --only auth,firestore \"playwright test\"",
    "e2e:ui": "npx firebase-tools emulators:exec --only auth,firestore \"playwright test --ui\""
  },
  "dependencies": {
    "animejs": "^4.5.0",
    "axios": "^1.11.0",
    "firebase": "^12.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-pro-sidebar": "^1.1.0",
    "react-router-dom": "^7.8.1",
    "react-toastify": "^11.0.5",
    "three": "^0.185.1",
    "vite-plugin-svgr": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "firebase-admin": "^14.4.0",
    "globals": "^16.3.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^7.1.2",
    "vitest": "^5.0.1"
  }
}
